# Tops do Job V3 - exemplo de ambiente de pre-producao isolada.
# O arquivo real deve existir somente em /opt/topsv3/secrets/preprod.env (modo 600).
# Acesso externo apenas por tunel SSH; nao ha dominio, DNS ou Nginx do host.

TOPSV3_POSTGRES_DB=topsv3_preprod
TOPSV3_POSTGRES_USER=topsv3_preprod
DATABASE_PASSWORD=__PREENCHER_FORA_DO_GIT__

APP_EVENT_HASH_SALT=__PREENCHER_FORA_DO_GIT__
APP_AGE_GATE_SIGNING_VALUE=__PREENCHER_FORA_DO_GIT__

# Leitura publica server-side do frontend; o valor real e definido pelo Compose.
PUBLIC_API_TIMEOUT_MS=5000

# Comunicacoes externas ficam retidas no Mailpit interno da pre-producao.
# Gere uma chave AES aleatoria de 32 bytes em Base64 e mantenha somente no secret externo.
OUTBOX_PAYLOAD_ENCRYPTION_KEY=__PREENCHER_FORA_DO_GIT__
OUTBOX_RECIPIENT_MODE=CAPTURE
OUTBOX_CAPTURE_ADDRESS=capture@preprod.invalid
OUTBOX_ALLOWED_RECIPIENTS=
OUTBOX_SENDER_ADDRESS=no-reply@topsdojob.com
OUTBOX_SENDER_NAME=Tops do Job
OUTBOX_REPLY_TO=
OUTBOX_SMTP_HOST=mailpit
OUTBOX_SMTP_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=__PREENCHER_FORA_DO_GIT__
OUTBOX_SMTP_AUTH=false
OUTBOX_SMTP_STARTTLS=false
OUTBOX_SMTP_STARTTLS_REQUIRED=false
# Efí homologacao. O certificado PKCS12 fica fora do Git em
# /opt/topsv3/secrets/efi/homologacao-892970-teste-v3.p12.
EFI_ENABLED=false
EFI_CLIENT_ID=__PREENCHER_FORA_DO_GIT__
EFI_CLIENT_SECRET=__PREENCHER_FORA_DO_GIT__
EFI_CERTIFICATE_PROTECTION_VALUE=
EFI_PIX_CHAVE=__PREENCHER_FORA_DO_GIT__
EFI_WEBHOOK_BASE_URL=https://v3.esle.cloud/api/public/webhooks/efi
EFI_WEBHOOK_VERIFIER_VALUE=__PREENCHER_FORA_DO_GIT__
EFI_WEBHOOK_REGISTRATION_ENABLED=false
EFI_WEBHOOK_SKIP_MTLS_CHECKING=false
EFI_CHARGE_EXPIRATION_SECONDS=3600
EFI_RECONCILIATION_ENABLED=false
EFI_RECONCILIATION_INTERVAL_MS=60000
EFI_RECONCILIATION_BATCH_SIZE=25
EFI_RECONCILIATION_MAX_PER_CYCLE=100
EFI_RECONCILIATION_RETRY_BACKOFF_SECONDS=300
# Arquivo externo com diretivas allow e deny; nunca registrar IPs no repositorio.
EFI_WEBHOOK_ALLOWLIST_FILE=/opt/topsv3/secrets/efi/webhook-allowlist.conf

# Reutiliza os buckets HML aprovados com subprefixos exclusivos de pre-producao.
# As credenciais permanecem fora do Git e nao devem ter acesso aos buckets de producao.
R2_ENABLED=true
R2_ENDPOINT=__PREENCHER_FORA_DO_GIT__
R2_REGION=auto
R2_ACCESS_KEY=__PREENCHER_FORA_DO_GIT__
R2_SIGNING_VALUE=__PREENCHER_FORA_DO_GIT__
R2_PUBLIC_MEDIA_BUCKET=topsdojob-hml-midias-publicas
R2_PRIVATE_MEDIA_BUCKET=topsdojob-hml-midias-privadas
R2_DOCUMENT_BUCKET=topsdojob-hml-documentos
R2_PUBLIC_MEDIA_PREFIX=hml/preprod/midias-aprovadas/
R2_PRIVATE_MEDIA_PREFIX=hml/preprod/midias-pendentes/
R2_DOCUMENT_PREFIX=hml/preprod/documentos/
R2_PUBLIC_BASE_URL=
R2_PRESERVED_PUBLIC_MEDIA_BUCKET=
R2_PRESERVED_PUBLIC_MEDIA_PREFIX=
R2_PRESERVED_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_DOCUMENT_BYTES=12582912
