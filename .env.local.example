# Tops do Job V3 - ambiente local

APP_ENV=local
APP_CANONICAL_DOMAIN=http://localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EFI_PIX_MOCK_MODE=true

COMPOSE_PROJECT_NAME=topsv3-local

TOPSV3_POSTGRES_IMAGE=postgres:16.6-alpine
TOPSV3_POSTGRES_PORT=54329
TOPSV3_POSTGRES_DB=topsv3_local
TOPSV3_POSTGRES_USER=topsv3_local
TOPSV3_POSTGRES_PASSWORD=CHANGE_ME

TOPSV3_MINIO_IMAGE=minio/minio:RELEASE.2024-07-16T23-46-41Z
TOPSV3_MINIO_API_PORT=9000
TOPSV3_MINIO_CONSOLE_PORT=9001
TOPSV3_MINIO_ROOT_USER=topsv3_local
TOPSV3_MINIO_ROOT_PASSWORD=CHANGE_ME

TOPSV3_MAILPIT_IMAGE=axllent/mailpit:v1.20.4
TOPSV3_MAILPIT_SMTP_PORT=1025
TOPSV3_MAILPIT_HTTP_PORT=8025
